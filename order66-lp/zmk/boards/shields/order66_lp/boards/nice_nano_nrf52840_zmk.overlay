/*
 * Backlight data line: 60 SK6812MINI-E on one chain, clocked out of SPIM3 MOSI.
 *
 * P0.06 is the nice!nano pin freed up by dropping the nice!view (it was the display
 * CS line). It is also the pin upstream ZMK's own reference overlays use for this,
 * e.g. app/boards/shields/splitkb_aurora_sofle/boards/nice_nano_v2.overlay.
 *
 * On the board P0.06 goes through a 1k series resistor into a 74AHCT1G125 powered
 * from the 5 V LED rail, because an SK6812 at 5 V wants a logic high above ~3.5 V
 * and the nRF52840 only drives 3.3 V.
 *
 * Filename note: upstream ZMK migrated to Zephyr's hardware model v2, so the board
 * is `nice_nano//zmk` with v2 as a revision, and board-specific shield overlays are
 * named after the board target rather than `nice_nano_v2.overlay`. 26 upstream
 * shields use this exact filename.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/led/led.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <60>; /* one per key */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};
