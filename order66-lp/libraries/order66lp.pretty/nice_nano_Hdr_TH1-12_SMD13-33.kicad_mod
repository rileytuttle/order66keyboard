(footprint "nice_nano_Hdr_TH1-12_SMD13-33"
	(version 20241229)
	(generator "gen_nano_footprint.py")
	(layer "F.Cu")
	(descr "nice!nano v2 on headers, mixed mount: pins 1-12 through-hole, pins 13-24 and 31-33 surface-mount. For boards where a THT pin on both rows would foul the switch bodies on the opposite face. Pins 31-33 are interior pads and need their own 1x3 header. Derived from nice-nano-kicad by tools/gen_nano_footprint.py.")
